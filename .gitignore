# Keep host-specific files private by default. Tracked files remain editable.
*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/LICENSE
!/README.md
!/go.mod
!/go.sum
!/main.go
!/FileSearch
!/cmd/
!/cmd/**/
!/cmd/**/*.go
!/internal/
!/internal/**/
!/internal/**/*.go
!/internal/panel/scripts/*.py
!/scripts/
!/docs/
!/web/
!/web/src/
!/web/src/**/
!/web/src/**/*.vue
!/web/src/**/*.ts
!/web/src/**/*.css

# Runtime and generated trees must stay excluded even during directory traversal.
/data/
/tools/
/bin/
/agents/
/artifacts/
/web/dist/
/web/node_modules/
**/__pycache__/
